# SQLite database stored on the Windows computer running the application.
# Paths in SQLite DATABASE_URL are resolved relative to prisma/schema.prisma.
# Copy this file to .env before first run.
DATABASE_URL="file:./ohda.db"

# Optional default center used when this installation has no saved center selection yet.
# On the current Ramtha installation this may remain RAMTHA.
DEFAULT_CENTER_CODE="RAMTHA"

# رمز الدخول للنظام عند فتحه من الهاتف أو أي جهاز على الشبكة.
# اتركه فارغاً لتعطيل الحماية (غير منصوح به عند استخدام start:lan).
# برنامج ويندوز (Electron) يولّد رمزاً تلقائياً ويعرضه في الصفحة الرئيسية.
OHDA_PASSWORD=""
