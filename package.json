{
  "name": "ohda-manager",
  "version": "0.1.1",
  "private": true,
  "author": "Smart Code Jo",
  "description": "نظام إدارة العهد واللوازم - مركز الرمثا",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "desktop:prepare": "node desktop/prepare.cjs",
    "desktop:run": "npm run build && npm run desktop:prepare && electron .",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --win nsis",
    "desktop:dir": "npm run build && npm run desktop:prepare && electron-builder --win dir",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "backup:db": "tsx scripts/backup-sqlite.ts",
    "import:ramtha": "tsx scripts/import-ramtha-xlsx.ts",
    "test:db": "tsx scripts/create-test-xlsx.ts .tmp/ramtha-test.xlsx && tsx scripts/import-ramtha-xlsx.ts .tmp/ramtha-test.xlsx --date=2025-12-31 && tsx scripts/verify-test-import.ts",
    "test:posting": "tsx scripts/test-posting.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "exceljs": "^4.4.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "org.iccs.ohda",
    "productName": "نظام إدارة العهد واللوازم",
    "asar": false,
    "directories": {
      "app": "desktop/app",
      "output": "dist-desktop",
      "buildResources": "desktop"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "desktop/server",
        "to": "server"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Ohda-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "إدارة العهد واللوازم"
    }
  }
}

